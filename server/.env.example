# ==============================================
# Smart RFID Library System - Backend Env Vars
# ==============================================
# Set these as Environment Variables in Vercel Dashboard (or your host)

PORT=5001
JWT_SECRET=your_secure_jwt_secret_here_change_this

# DB_TYPE can be 'mysql' or 'sqlite'
# NOTE: SQLite file-based DB does NOT persist on Vercel serverless (ephemeral filesystem).
# Use DB_TYPE=mysql and point to a managed DB (e.g. PlanetScale, Railway MySQL, Neon).
DB_TYPE=mysql

# MySQL Configurations
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=smart_rfid_library

# Library Fine Settings
FINE_PER_DAY=10.00
ISSUE_DURATION_DAYS=14

# CORS - set to your Vercel frontend URL in production
CORS_ORIGIN=https://your-frontend.vercel.app
