# ==============================================
# Smart RFID Library System - Frontend Env Vars
# ==============================================
# Copy this to .env.local for local development
# Set these as Environment Variables in Vercel Dashboard

# Your deployed backend URL (e.g. from Render/Railway/Vercel)
VITE_API_URL=https://your-backend-domain.vercel.app/api

# Your WebSocket server URL (must be a persistent server, NOT Vercel serverless)
# Recommended: deploy server on Railway or Render for WebSocket support
VITE_WS_URL=wss://your-backend-domain.onrender.com
